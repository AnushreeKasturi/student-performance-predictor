# Copy to .env for local development. Never commit the real .env.
# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional: defaults to SQLite at instance/app.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to 1 in production (HTTPS only cookies)
SESSION_COOKIE_SECURE=0

# Set to 1 for the auto-reloading debugger when running `python app.py`
FLASK_DEBUG=0
